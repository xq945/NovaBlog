# ============================================================
# NovaBlog Docker 环境变量配置
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# ============================================================

# MySQL 配置（Docker 内部使用）
MYSQL_ROOT_PASSWORD=123456

# Redis 配置（Docker 内部使用）
REDIS_PASSWORD=123456

# JWT 密钥（Base64 编码，256 位以上）
# 生成命令：openssl rand -base64 64
# 复制为 .env 后，将下方留空处替换为你自行生成的密钥（切勿使用示例中的值）
NOVABLOG_JWT_SECRET=

# ============================================================
# 以下为可选配置（不填不影响应用启动）
# ============================================================

# 阿里云 OSS（文件上传）
# ALIYUN_OSS_ENDPOINT=
# ALIYUN_OSS_BUCKET=
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=

# AI / RAG 服务（AI 对话和自动摘要）
# AI_ENABLED=false
# AI_CHAT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
